# Define the base image dynamically
ARG BASE_IMAGE=ubuntu:22.04
FROM ${BASE_IMAGE}
ARG BLACKBOXDB_VERSION
ARG DEBIAN_FRONTEND=noninteractive
ENV BLACKBOXDB_VERSION=${BLACKBOXDB_VERSION}

RUN apt-get update; \
    apt-get install -y --no-install-recommends software-properties-common jq curl sudo git make wget build-essential openssl pkg-config libssl-dev ca-certificates lsb-release gnupg2; \
    rm -rf /var/lib/apt/lists/*

RUN useradd -ms /bin/bash blackboxdb -G sudo
RUN mkdir -p /etc/sudoers.d && echo "%sudo ALL=(ALL:ALL) NOPASSWD: ALL" > /etc/sudoers.d/no-pass-ask

USER blackboxdb
WORKDIR /home/blackboxdb/code

COPY . /home/blackboxdb/code

RUN sudo chown -R blackboxdb:blackboxdb /home/blackboxdb/code
RUN sudo chmod +x /home/blackboxdb/code/scripts/*.sh
RUN /home/blackboxdb/code/scripts/install_llvm.sh

# Install rustup (which includes rustc and cargo) in user directory
ENV RUSTUP_HOME=/home/blackboxdb/.rustup
ENV CARGO_HOME=/home/blackboxdb/.cargo
RUN mkdir -p $RUSTUP_HOME && mkdir -p $CARGO_HOME
ENV PATH=$PATH:$CARGO_HOME/bin

RUN /home/blackboxdb/code/scripts/install_rustup.sh --install-toolchain

WORKDIR /home/blackboxdb/code/pg_blackboxdb_gw

# Pin the workspace Cargo.toml version to BLACKBOXDB_VERSION so the
# binary's CARGO_PKG_VERSION (used by telemetry as service.version), the
# `dpkg -l` package version, and the deb filename all agree. The source
# version "0.1.0" is intentionally kept in git for development; packaging
# overrides it at build time. Sanity-check the substitution worked.
RUN if [ -z "$BLACKBOXDB_VERSION" ]; then \
        echo "ERROR: BLACKBOXDB_VERSION build-arg is required" >&2; exit 1; \
    fi && \
    sed -i -E "s/^version = \".*\"/version = \"${BLACKBOXDB_VERSION}\"/" Cargo.toml && \
    if ! grep -Eq "^version = \"${BLACKBOXDB_VERSION}\"$" Cargo.toml; then \
        echo "ERROR: failed to set workspace Cargo.toml version to ${BLACKBOXDB_VERSION}" >&2; \
        exit 1; \
    fi

RUN CARGO_MANIFEST_DIR=/home/blackboxdb/code/pg_blackboxdb_gw cargo build --profile=release-with-symbols -p blackboxdb_gateway

# Create /output directory and set permissions for the blackboxdb user
USER root
RUN mkdir -p /output && chown blackboxdb:blackboxdb /output
RUN apt-get update && apt-get install -y --no-install-recommends dpkg-dev && rm -rf /var/lib/apt/lists/*
USER blackboxdb

CMD ["/bin/bash", "-c", "set -euo pipefail && test -n \"$OS\" || (echo \"OS not set\" && false) && /home/blackboxdb/code/packaging/gateway/build-gateway-deb.sh --binary /home/blackboxdb/code/pg_blackboxdb_gw/target/release-with-symbols/blackboxdb_gateway --version \"$BLACKBOXDB_VERSION\" --output-dir /output && cd /output && for f in blackboxdb-gateway_*.deb; do mv \"$f\" \"$OS-$f\"; done"]
