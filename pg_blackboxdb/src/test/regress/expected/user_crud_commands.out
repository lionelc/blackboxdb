 test_is_reserved_role_name 
----------------------------
 t
(1 row)

-- IS_SYSTEM_LOGIN_ROLE: system login roles should be reserved
SELECT blackboxdb_test_helpers.test_is_reserved_role_name('blackboxdb_bg_worker_role');
 test_is_reserved_role_name 
