--Try to create a readOnly user without passing in the role as  part of an array
SELECT blackboxdb_api.create_user('{"createUser":"test_user", "pwd":"Valid$123Pass", "roles":{"role":"readAnyDatabase","db":"admin"}, "$db":"admin"}');
