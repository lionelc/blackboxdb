-----------------------------------------------------------------------
 { "$" : { "$numberInt" : "1" }, "$flags" : { "$numberInt" : "133" } }
(1 row)

SELECT bsonindexterm_to_bson(bson_orderby_index_reverse('{ "a": [ 1, { "b": 1 }, { "b": 2 } ] }', '{ "a.b": 1 }'));
                        bsonindexterm_to_bson                        
---------------------------------------------------------------------
 { "$" : { "$numberInt" : "2" }, "$flags" : { "$numberInt" : "5" } }
