-- The bound keeps its index scan: the null equality is a second index condition on the same index
SET blackboxdb.enable_minmaxkey_missing_path_match TO on;
SET enable_seqscan TO off;
EXPLAIN (COSTS OFF) SELECT document FROM bson_aggregation_find('minmaxdb', '{ "find": "c", "filter": { "elem": { "$lt": { "$maxKey": 1 } } } }');
                                                    QUERY PLAN                                                     
-------------------------------------------------------------------------------------------------------------------
 Bitmap Heap Scan on documents_26930001 collection
   Recheck Cond: ((document @< '{ "elem" : { "$maxKey" : 1 } }'::bson) OR (document @= '{ "elem" : null }'::bson))
   ->  BitmapOr
         ->  Bitmap Index Scan on elem_1
               Index Cond: (document @< '{ "elem" : { "$maxKey" : 1 } }'::bson)
         ->  Bitmap Index Scan on elem_1
               Index Cond: (document @= '{ "elem" : null }'::bson)
(7 rows)

EXPLAIN (COSTS OFF) SELECT document FROM bson_aggregation_find('minmaxdb', '{ "find": "c2", "filter": { "elem": { "$gt": { "$minKey": 1 } } } }');
                                                    QUERY PLAN                                                     
-------------------------------------------------------------------------------------------------------------------
 Bitmap Heap Scan on documents_26930002 collection
   Recheck Cond: ((document @> '{ "elem" : { "$minKey" : 1 } }'::bson) OR (document @= '{ "elem" : null }'::bson))
   ->  BitmapOr
         ->  Bitmap Index Scan on elem_1
               Index Cond: (document @> '{ "elem" : { "$minKey" : 1 } }'::bson)
         ->  Bitmap Index Scan on elem_1
               Index Cond: (document @= '{ "elem" : null }'::bson)
(7 rows)

-- _id is never missing, so its bounds stay a plain comparison
EXPLAIN (COSTS OFF) SELECT document FROM bson_aggregation_find('minmaxdb', '{ "find": "c", "filter": { "_id": { "$gte": { "$minKey": 1 }, "$lt": { "$maxKey": 1 } } } }');
                                                                                                                                  QUERY PLAN                                                                                                                                   
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Index Scan using _id_ on documents_26930001 collection
   Index Cond: ((shard_key_value = '26930001'::bigint) AND (object_id >= '{ "" : { "$minKey" : 1 } }'::bson) AND (object_id <= '{ "" : { "$maxKey" : 1 } }'::bson) AND (object_id < '{ "" : { "$maxKey" : 1 } }'::bson) AND (object_id >= '{ "" : { "$minKey" : 1 } }'::bson))
(2 rows)

RESET enable_seqscan;
RESET blackboxdb.enable_minmaxkey_missing_path_match;
