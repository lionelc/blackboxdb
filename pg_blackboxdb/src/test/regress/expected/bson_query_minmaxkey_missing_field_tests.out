SET search_path TO blackboxdb_api, blackboxdb_core, blackboxdb_api_catalog;
SET blackboxdb.next_collection_id TO 26930000;
SET blackboxdb.next_collection_index_id TO 26930000;
-- A missing path compares like null, and null sorts above MinKey and below MaxKey. So $gt/$gte against MinKey
-- and $lt/$lte against MaxKey also match a document without the path (a dotted path follows the null rules
-- through arrays), and their $not forms exclude it. With blackboxdb.enable_minmaxkey_missing_path_match on, every
-- access path returns that answer: a collection scan, the ordered index (c) and a single-path index (c2).
-- Document 9 has no elem; 16 has a subdocument without k. $exists and _id keep their meaning.
SELECT COUNT(*) FROM (SELECT blackboxdb_api.insert_one('minmaxdb', 'c', d::blackboxdb_core.bson) FROM (VALUES
  ('{"_id": 1, "elem": [7, 8]}'),
  ('{"_id": 2, "elem": [9, 10]}'),
  ('{"_id": 3, "elem": 8}'),
  ('{"_id": 4, "elem": 9}'),
  ('{"_id": 5, "elem": null}'),
  ('{"_id": 6, "elem": []}'),
  ('{"_id": 7, "elem": [null]}'),
  ('{"_id": 8, "elem": [null, 9]}'),
  ('{"_id": 9}'),
  ('{"_id": 10, "elem": {"k": 5}}'),
  ('{"_id": 11, "elem": [{"k": 7}]}'),
  ('{"_id": 12, "elem": {"$minKey": 1}}'),
  ('{"_id": 13, "elem": [{"$maxKey": 1}, 9]}'),
  ('{"_id": 14, "elem": {"$maxKey": 1}}'),
  ('{"_id": 15, "elem": [{"$minKey": 1}]}'),
  ('{"_id": 16, "other": 1, "elem": {"j": 1}}')) v(d)) x;
NOTICE:  creating collection
 count 
-------
    16
(1 row)

