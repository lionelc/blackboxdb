ROLLBACK;
-- fails gracefully when transaction is read-only.
CALL blackboxdb_api_internal.delete_expired_rows();
INFO:  TTL job skipping because transaction is read-only.
set blackboxdb.enableTTLJobsOnReadOnly to on;
CALL blackboxdb_api_internal.delete_expired_rows();
