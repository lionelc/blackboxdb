SELECT document FROM bson_aggregation_pipeline('letrand', '{"aggregate": "c", "pipeline": [{"$project": {"v": {"$let": {"vars": {"x": {"$rand": {}}}, "in": {"$eq": ["$$x", "$$x"]}}}}}, {"$match": {"v": false}}, {"$count": "n"}], "cursor": {}}');
