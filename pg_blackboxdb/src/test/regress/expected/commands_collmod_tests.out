SET search_path TO blackboxdb_api_catalog;
SET blackboxdb.next_collection_id TO 8700;
SET blackboxdb.next_collection_index_id TO 8700;
SELECT blackboxdb_api.create_collection('collmod','coll_mod_test_hidden');
NOTICE:  creating collection
 create_collection 
-------------------
 t
(1 row)

SELECT COUNT(blackboxdb_api.insert_one('collmod','coll_mod_test_hidden', FORMAT('{"_id":"%s", "a": %s }', i, i )::blackboxdb_core.bson)) FROM generate_series(1, 100) i;
 count 
-------
   100
(1 row)

-- cannot create an index as hidden
SELECT blackboxdb_api_internal.create_indexes_non_concurrently('collmod', '{"createIndexes": "coll_mod_test_hidden", "indexes": [{"key": {"a": 1}, "name": "my_idx_1", "hidden": true  }]}');
ERROR:  hidden indexes are not supported yet.
SELECT blackboxdb_api_internal.create_indexes_non_concurrently('collmod', '{"createIndexes": "coll_mod_test_hidden", "indexes": [{"key": {"a": 1}, "name": "my_idx_1" }]}', TRUE);
