ANALYZE blackboxdb_data.documents_8701;
-- get list index output
SELECT blackboxdb_api_catalog.bson_dollar_unwind(cursorpage, '$cursor.firstBatch') FROM blackboxdb_api.list_indexes_cursor_first_page('collmod', '{ "listIndexes": "coll_mod_test_hidden" }');
