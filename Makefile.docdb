

ifeq ($(USE_BLACKBOXDB_CORE),1)
$(MODULE_big)$(DLSUFFIX): $(BLACKBOXDB_CORE_LIB)
DOCDB_CORE_SOURCES=$(wildcard $(BLACKBOXDB_CORE_DIR)/src/*.c) $(wildcard $(BLACKBOXDB_CORE_DIR)/src/**/*.c)
$(BLACKBOXDB_CORE_LIB): $(DOCDB_CORE_SOURCES)
	$(MAKE) EXTRA_INCLUDE=$(EXTRA_INCLUDE) -C $(BLACKBOXDB_CORE_DIR)

install: install_blackboxdb_core
install_blackboxdb_core: $(DOCDB_CORE_SOURCES)
	$(MAKE) EXTRA_INCLUDE=$(EXTRA_INCLUDE) -C $(BLACKBOXDB_CORE_DIR) install

endif

ifeq ($(USE_BLACKBOXDB),1)
DOCDB_SOURCES=$(wildcard $(BLACKBOXDB_DIR)/src/*.c) $(wildcard $(BLACKBOXDB_DIR)/src/**/*.c)
$(MODULE_big)$(DLSUFFIX): $(BLACKBOXDB_LIB)
$(BLACKBOXDB_LIB): $(BLACKBOXDB_CORE_LIB) $(DOCDB_SOURCES)
	$(MAKE) EXTRA_INCLUDE=$(EXTRA_INCLUDE) -C $(BLACKBOXDB_DIR)

install: install_blackboxdb
install_blackboxdb:  $(DOCDB_SOURCES)
	$(MAKE) EXTRA_INCLUDE=$(EXTRA_INCLUDE) -C $(BLACKBOXDB_DIR) install
endif

ifeq ($(USE_BLACKBOXDB_DISTRIBUTED),1)

DOCDB_DIST_SOURCES=$(wildcard $(BLACKBOXDB_DISTRIBUTED_DIR)/src/*.c) $(wildcard $(BLACKBOXDB_DISTRIBUTED_DIR)/src/**/*.c)
$(MODULE_big)$(DLSUFFIX): $(BLACKBOXDB_DISTRIBUTED_LIB)
$(BLACKBOXDB_DISTRIBUTED_LIB): $(BLACKBOXDB_LIB) $(BLACKBOXDB_CORE_LIB) $(DOCDB_DIST_SOURCES)
	$(MAKE) EXTRA_INCLUDE=$(EXTRA_INCLUDE) -C $(BLACKBOXDB_DISTRIBUTED_DIR)

install: install_blackboxdb_distributed
install_blackboxdb_distributed: $(DOCDB_DIST_SOURCES)
	$(MAKE) EXTRA_INCLUDE=$(EXTRA_INCLUDE) -C $(BLACKBOXDB_DISTRIBUTED_DIR) install
endif
