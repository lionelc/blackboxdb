SET search_path to blackboxdb_api_catalog;
SET citus.next_shard_id TO 11980000;
SET blackboxdb.next_collection_id TO 11980;
SET blackboxdb.next_collection_index_id TO 11980;
-- create new user with basic and insufficient permissions
CREATE ROLE user_2 WITH LOGIN PASSWORD 'pass';
GRANT ALL PRIVILEGES ON SCHEMA blackboxdb_api_catalog TO user_2;
GRANT ALL PRIVILEGES ON ALL TABLES IN SCHEMA blackboxdb_api_catalog TO user_2;
GRANT SELECT ON ALL TABLES IN SCHEMA blackboxdb_data TO user_2;
GRANT USAGE ON SCHEMA blackboxdb_data TO user_2;
GRANT USAGE ON SCHEMA blackboxdb_api TO user_2;
GRANT USAGE ON SCHEMA blackboxdb_api_internal TO user_2;
-- create a collection
SELECT blackboxdb_api.create_collection('db', 'test_coll');
NOTICE:  creating collection
 create_collection 
---------------------------------------------------------------------
 t
(1 row)

-- insert some data
SELECT blackboxdb_api.insert_one('db','test_coll','{"_id":"1", "a": { "$numberInt" : "11" }, "b": { "$numberInt" : "214748" }, "c": { "$numberInt" : "100" }}', NULL);
                              insert_one                              
---------------------------------------------------------------------
 { "n" : { "$numberInt" : "1" }, "ok" : { "$numberDouble" : "1.0" } }
(1 row)

SELECT blackboxdb_api.insert_one('db','test_coll','{"_id":"2", "a": { "$numberInt" : "16" }, "b": { "$numberInt" : "214740" }, "c": { "$numberInt" : "-22" }}', NULL);
                              insert_one                              
---------------------------------------------------------------------
 { "n" : { "$numberInt" : "1" }, "ok" : { "$numberDouble" : "1.0" } }
(1 row)

SELECT blackboxdb_api.insert_one('db','test_coll','{"_id":"3", "a": { "$numberInt" : "52" }, "b": { "$numberInt" : "121212" }, "c": { "$numberInt" : "101" }}', NULL);
                              insert_one                              
---------------------------------------------------------------------
 { "n" : { "$numberInt" : "1" }, "ok" : { "$numberDouble" : "1.0" } }
(1 row)

-- switch to the new user (user_2)
SELECT current_user as original_user \gset
ALTER TABLE blackboxdb_data.documents_11980 OWNER TO user_2;
\c - user_2
-- should fail index creation
SELECT blackboxdb_api_internal.create_indexes_non_concurrently('db', '{ "createIndexes": "test_coll", "indexes": [ { "key" : { "a": 1 }, "name": "index_a"}] }', true);
ERROR:  permission denied for schema blackboxdb_core
-- switch back to default user
\c - :original_user
ALTER TABLE blackboxdb_data.documents_11980 OWNER TO blackboxdb_admin_role;
-- index creation should succeed
SELECT blackboxdb_api_internal.create_indexes_non_concurrently('db', '{ "createIndexes": "test_coll", "indexes": [ { "key" : { "a": 1 }, "name": "index_a"}] }', true);
                                                                                                   create_indexes_non_concurrently                                                                                                    
---------------------------------------------------------------------
 { "raw" : { "defaultShard" : { "numIndexesBefore" : { "$numberInt" : "1" }, "numIndexesAfter" : { "$numberInt" : "2" }, "createdCollectionAutomatically" : false, "ok" : { "$numberInt" : "1" } } }, "ok" : { "$numberInt" : "1" } }
(1 row)

-- revoke all privileges and drop role
REVOKE ALL PRIVILEGES ON SCHEMA blackboxdb_api_catalog FROM user_2;
REVOKE ALL PRIVILEGES ON ALL TABLES IN SCHEMA blackboxdb_api_catalog FROM user_2;
REVOKE SELECT ON ALL TABLES IN SCHEMA blackboxdb_data FROM user_2;
REVOKE USAGE ON SCHEMA blackboxdb_data FROM user_2;
REVOKE USAGE ON SCHEMA blackboxdb_api FROM user_2;
REVOKE USAGE ON SCHEMA blackboxdb_api_internal FROM user_2;
DROP ROLE IF EXISTS user_2;
