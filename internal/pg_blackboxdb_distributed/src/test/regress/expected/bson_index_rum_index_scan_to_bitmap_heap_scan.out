-- Even if there is an index order_id_1, performs BitmapHeapScan instead of Index Scan 
BEGIN;
set local enable_seqscan TO off;
SET LOCAL blackboxdb.ForceUseIndexIfAvailable to OFF;
EXPLAIN (COSTS OFF) SELECT count(*) FROM blackboxdb_api.collection('db', 'bson_index_rum_index_scan_to_bitmap_heap_scan') WHERE document OPERATOR(blackboxdb_api_catalog.@@) '{"order_id": "ORD1" }'::bson LIMIT 10;
                                                                 QUERY PLAN                                                                 
---------------------------------------------------------------------
 Custom Scan (Citus Adaptive)
   Task Count: 1
   Tasks Shown: All
   ->  Task
         Node: host=localhost port=58070 dbname=regression
         ->  Limit
               ->  Aggregate
                     ->  Bitmap Heap Scan on documents_5010_50100 collection
                           Recheck Cond: (document OPERATOR(blackboxdb_api_catalog.@=) '{ "order_id" : "ORD1" }'::blackboxdb_core.bson)
                           ->  Bitmap Index Scan on order_id_1
                                 Index Cond: (document OPERATOR(blackboxdb_api_catalog.@=) '{ "order_id" : "ORD1" }'::blackboxdb_core.bson)
(11 rows)

END;
-- Tets for paralell BitmapHeapScan. Needs all the 5 config and at 500 docs in the collection to enable parallel bitmap scan.
BEGIN;
set local parallel_tuple_cost TO 0.00001;
set local parallel_setup_cost TO 0;
set local min_parallel_table_scan_size TO 0;
set local min_parallel_index_scan_size TO 0;
SET local enable_seqscan to OFF;
SET LOCAL blackboxdb.ForceUseIndexIfAvailable to OFF;
EXPLAIN (COSTS OFF) WITH t1 as (SELECT document FROM blackboxdb_api.collection('db', 'bson_index_rum_index_scan_to_bitmap_heap_scan') WHERE document OPERATOR(blackboxdb_api_catalog.@@) '{"order_id": "ORD2" , "$and": [{"timestamp" : { "$lte":2000000}}]}'::bson  ) SELECT bson_repath_and_build('rxCount'::text, BSONAVERAGE(document -> 'month')) from t1 group by bson_expression_get(document, '{ "": "$product_name" }');
                                                                           QUERY PLAN                                                                           
---------------------------------------------------------------------
 Custom Scan (Citus Adaptive)
   Task Count: 1
   Tasks Shown: All
   ->  Task
         Node: host=localhost port=58070 dbname=regression
         ->  GroupAggregate
               Group Key: (blackboxdb_api_catalog.bson_expression_get(collection.document, '{ "" : "$product_name" }'::blackboxdb_core.bson, false))
               ->  Gather Merge
                     Workers Planned: 2
                     ->  Sort
                           Sort Key: (blackboxdb_api_catalog.bson_expression_get(collection.document, '{ "" : "$product_name" }'::blackboxdb_core.bson, false))
                           ->  Parallel Bitmap Heap Scan on documents_5010_50100 collection
                                 Recheck Cond: (document OPERATOR(blackboxdb_api_catalog.@=) '{ "order_id" : "ORD2" }'::blackboxdb_core.bson)
                                 Filter: (document OPERATOR(blackboxdb_api_catalog.@<=) '{ "timestamp" : { "$numberInt" : "2000000" } }'::blackboxdb_core.bson)
                                 ->  Bitmap Index Scan on order_id_1
                                       Index Cond: (document OPERATOR(blackboxdb_api_catalog.@=) '{ "order_id" : "ORD2" }'::blackboxdb_core.bson)
(16 rows)

ROLLBACK;
