EXPLAIN(costs off) SELECT count(*) FROM blackboxdb_api.collection('db', 'bson_index_rum_index_scan_to_bitmap_heap_scan') WHERE document OPERATOR(blackboxdb_api_catalog.@@) '{"order_id": "ORD1" }'::bson LIMIT 10;
