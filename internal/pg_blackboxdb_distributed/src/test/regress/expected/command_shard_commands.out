SELECT * FROM public.citus_tables tbls JOIN
    (SELECT 'blackboxdb_data.documents_' || collection_id AS mongo_table_name FROM blackboxdb_api_catalog.collections WHERE database_name = 'comm_sh_coll'
    UNION ALL SELECT 'blackboxdb_data.retry_' || collection_id AS mongo_table_name FROM blackboxdb_api_catalog.collections WHERE database_name = 'comm_sh_coll') colls ON tbls.table_name::text = colls.mongo_table_name
    ORDER BY colocation_id ASC;
